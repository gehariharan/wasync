#!/bin/sh
# Put back a wasync-axi symlink that preinstall set aside, so another
# installation method keeps owning the command.
kept=/usr/local/bin/.wasync-axi.kept
if [ -L "$kept" ]; then
  mv -f "$kept" /usr/local/bin/wasync-axi
fi
# Keep the old command name, whatsapp-axi, as a link to wasync-axi unless
# another program owns that name.
old=/usr/local/bin/whatsapp-axi
if [ -L "$old" ]; then
  [ "$(readlink "$old")" = wasync-axi ] || exit 0
elif [ -e "$old" ] && ! LC_ALL=C grep -aq 'gehariharan/wasync/axi' "$old" 2>/dev/null; then
  exit 0
fi
ln -sf wasync-axi "$old"
exit 0
